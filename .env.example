# Required: OpenAI API key used to generate each golfer's 8-bit pixel-art avatar.
OPENAI_API_KEY=

# Optional: override the image model (defaults to gpt-image-1).
OPENAI_IMAGE_MODEL=

# Vercel Blob storage — Vercel injects this automatically once you attach
# Blob storage to your project. Only set it by hand for local development
# (create a store at https://vercel.com/dashboard/stores and copy its token).
BLOB_READ_WRITE_TOKEN=
